{
  "name": "pressgo-desktop",
  "productName": "PressGO",
  "version": "1.1.0",
  "description": "PressGO desktop app for Windows. Opens the live PressGO site and updates itself from the official GitHub Releases.",
  "main": "main.js",
  "author": "Reliable Printers",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node --test",
    "icon": "node make-icon.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.reliableprinters.pressgo",
    "productName": "PressGO",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "contextmenu.js",
      "updater.js",
      "preload.js",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "artifactName": "PressGO-Portable.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PressGO-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ReliablePrinters",
        "repo": "PressGO",
        "releaseType": "release"
      }
    ]
  }
}
